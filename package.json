{
  "name": "qa-knowledge",
  "version": "1.0.0",
  "private": true,
  "description": "本地 QA/RD 知識庫。scripts/build.js 建站，scripts/serve.js 本地 server，scripts/smoketest.js 迴歸測試。",
  "author": "Emma Chen",
  "main": "desktop/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "serve": "node scripts/serve.js",
    "test": "node scripts/smoketest.js",
    "desktop": "electron .",
    "desktop:build": "electron-builder"
  },
  "build": {
    "appId": "tw.jvd.qa-knowledge",
    "productName": "QA Knowledge",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "desktop/**/*",
      "!desktop/gen-icons.js",
      "package.json"
    ],
    "mac": { "target": "dir", "category": "public.app-category.productivity", "identity": null },
    "win": { "target": "dir" }
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "playwright": "1.59.1"
  }
}
